# ── Local Development (copy to .env, do NOT commit .env) ──

# Database (Docker Compose default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unityskill_dev
SPRING_DATASOURCE_USERNAME=unityskill
SPRING_DATASOURCE_PASSWORD=unityskill_dev_password

# Redis (Docker Compose default)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT (dev only — use a strong random secret in prod)
JWT_SECRET=dev-secret-key-placeholder-minimum-256-bits-long
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# App
SERVER_PORT=8080

# ── Production (set in Render environment variables) ──
# DATABASE_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres?user=postgres&password=xxx
# DB_USER=postgres
# DB_PASSWORD=<supabase-db-password>
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380
# JWT_SECRET=<generate with: openssl rand -base64 48>
# FRONTEND_URL=https://unity-skill.vercel.app
# PORT=8080  (set automatically by Render)
