# ── Local Development (copy to .env, do NOT commit .env) ──────────────────────

# Database
SPRING_DATASOURCE_USERNAME=unityskill
SPRING_DATASOURCE_PASSWORD=unityskill_dev_password
# SPRING_DATASOURCE_URL is auto-configured in application-dev.yml

# Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT
JWT_SECRET=dev-secret-key-placeholder-minimum-256-bits-long
JWT_ACCESS_TOKEN_EXPIRY_MS=28800000
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Server
SERVER_PORT=8080

# Mail (Gmail App Password)
# Hướng dẫn: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=unity_skill

# GitHub OAuth2 — App 1: project connect (repo + admin:repo_hook scope)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# GitHub OAuth2 — App 2: login (user:email scope)
GITHUB_LOGIN_CLIENT_ID=your-github-login-client-id
GITHUB_LOGIN_CLIENT_SECRET=your-github-login-client-secret

# GitHub Webhook
# For local dev use ngrok: ngrok http 8080 → copy the https URL + /api/v1/webhooks/github
GITHUB_WEBHOOK_ENDPOINT_URL=https://your-ngrok-url.ngrok-free.app/api/v1/webhooks/github
GITHUB_FRONTEND_REDIRECT_BASE_URL=http://localhost:3000

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Encryption (for storing GitHub OAuth tokens)
# Generate: openssl rand -hex 16
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef
ENCRYPTION_SALT=deadbeef

# AI Provider (gemini | anthropic)
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (optional — used if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Cloudinary — image/video storage for ticket attachments
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Storage quota per workspace (bytes). Default = 500 MB
STORAGE_LIMIT_BYTES=524288000

# ── Production (set in Railway / Render environment variables) ─────────────────
# DATABASE_URL=jdbc:postgresql://host:port/dbname?options=-c%20TimeZone%3DUTC
# DB_USERNAME=postgres
# DB_PASSWORD=your-db-password
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380
# JWT_SECRET=<openssl rand -base64 48>
# FRONTEND_URL=https://your-frontend.vercel.app
# GITHUB_REDIRECT_URI=https://your-backend.railway.app/api/v1/auth/github/callback
# GITHUB_LOGIN_REDIRECT_URI=https://your-backend.railway.app/api/v1/auth/github/login/callback
# GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/v1/auth/google/callback
# GITHUB_WEBHOOK_ENDPOINT_URL=https://your-backend.railway.app/api/v1/webhooks/github
# PORT=8080
